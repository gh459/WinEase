<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinEaseGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="260"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,8,16,12" Spacing="4">
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="32,16,32,8" Spacing="2">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PageHost" Padding="32,8,32,32" Spacing="6" MaxWidth="1100" HorizontalAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Command bar: dry run, estimate, actions -->
        <Border
            Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox x:Name="DryRunCheck" MinWidth="0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EstimateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PresetDiffButton" Click="PresetDiffButton_Click" />
                    <Button x:Name="DependenciesButton" Click="DependenciesButton_Click" />
                    <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" MinWidth="180" Click="StartButton_Click" />
                    <Button x:Name="CancelButton" MinWidth="100" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
