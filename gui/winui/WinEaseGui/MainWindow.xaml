<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinEaseGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinEaseGui">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE7F8;" FontSize="16" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            TabIndex="0"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="260"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,8,16,12" Spacing="4">
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="32,16,32,8" Spacing="2">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" TabIndex="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageHost" Padding="32,8,32,32" Spacing="6" MaxWidth="1100" HorizontalAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Command bar: dry run, estimate, actions. Wide: one row. Narrow (or large text scale): the buttons move
             below the status and wrap, so Start / Cancel / Preset Diff / Dependencies never leave the window. -->
        <Border
            x:Name="CommandBar"
            Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            SizeChanged="CommandBar_SizeChanged">
            <Grid x:Name="CommandGrid" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="StatusArea" ColumnSpacing="16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="DryRunCheck" MinWidth="0" TabIndex="1" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="EstimateText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ProgressRing x:Name="BusyRing" Grid.Column="2" IsActive="False" Width="20" Height="20" />
                </Grid>
                <local:WrapPanel x:Name="ButtonArea" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PresetDiffButton" TabIndex="2" AccessKey="P" Click="PresetDiffButton_Click" />
                    <Button x:Name="DependenciesButton" TabIndex="3" AccessKey="D" Click="DependenciesButton_Click" />
                    <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" TabIndex="4" AccessKey="S" Click="StartButton_Click" />
                    <Button x:Name="CancelButton" TabIndex="5" AccessKey="C" Click="CancelButton_Click" />
                </local:WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
