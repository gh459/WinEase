{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gh459/WinEase/WinEase.config.schema.json",
  "title": "WinEase Build Configuration Profile",
  "description": "Schema for WinEase builder JSON profile files (used with -LoadProfile).",
  "type": "object",
  "properties": {
    "ProfileName": { "type": "string", "description": "Human-readable profile name" },
    "Description": { "type": "string", "description": "Profile description" },
    "Version": { "type": "string", "description": "Profile schema version (e.g. 2.1)" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Architecture": { "type": "string", "enum": ["amd64", "arm64"] },
    "RemoveDefender": { "type": "boolean", "default": false },
    "KeepAsianIME": { "type": "boolean", "default": true },
    "KeepExtraFonts": { "type": "boolean", "default": true },
    "RemoveDrivers": { "type": "boolean", "default": false },
    "DisableWindowsUpdate": { "type": "boolean", "default": false },
    "KeepBluetooth": { "type": "boolean", "default": true },
    "WSLSupport": { "type": "boolean", "default": false },
    "KeepRecoveryEnv": { "type": "boolean", "default": false },
    "SafeDebloatMode": { "type": "boolean", "default": true },
    "UltraSlimMode": { "type": "boolean", "default": true },
    "SetJapaneseKeyboard": { "type": "boolean", "default": true },
    "AtlasReviOSMode": { "type": "boolean", "default": true },
    "RemoveStore": { "type": "boolean", "default": false },
    "KeepBasicApps": { "type": "boolean", "default": false },
    "KeepSearchIndex": { "type": "boolean", "default": false },
    "KeepXboxServices": { "type": "boolean", "default": false },
    "KeepAudioTweaks": { "type": "boolean", "default": true },
    "UseVHDX": { "type": "boolean", "default": false },
    "RemoveLegacyFOD": { "type": "boolean", "default": true },
    "TrimWallpapers": { "type": "boolean", "default": true },
    "HibernateMode": { "type": "string", "enum": ["Off", "Reduced", "Keep"], "default": "Keep" },
    "CrashDumpMode": { "type": "string", "enum": ["Automatic", "Small", "None"], "default": "Automatic" },
    "DisableCPUMitigations": { "type": "boolean", "default": false },
    "MMCSSGaming": { "type": "boolean", "default": false },
    "DAWMode": { "type": "boolean", "default": false },
    "DisableMemCompression": { "type": "boolean", "default": true },
    "DisableFSE": { "type": "boolean", "default": false },
    "NvidiaLowLatency": { "type": "boolean", "default": false },
    "NoKernelPaging": { "type": "boolean", "default": true },
    "DisableUSBSuspend": { "type": "boolean", "default": true },
    "NoHypervisor": { "type": "boolean", "default": true },
    "RemoveWebViewPostOOBE": { "type": "boolean", "default": false },
    "FastExport": { "type": "boolean", "default": false },
    "UefiOnly": { "type": "boolean", "default": false },
    "BypassActivationRestrictions": { "type": "boolean", "default": true },
    "RemoveAppxBloatware": { "type": "boolean", "default": true },
    "RemoveCameraApp": { "type": "boolean", "default": true },
    "RemovePhotosApp": { "type": "boolean", "default": true },
    "RemoveScreenSketchApp": { "type": "boolean", "default": true },
    "RadicalRAM": { "type": "boolean", "default": true },
    "PayloadFormat": { "type": "string", "enum": ["WIM", "ESD", "SWM"], "default": "WIM" },
    "SkipEiCfg": { "type": "boolean", "default": false },
    "NoPostInstallAssets": { "type": "boolean", "default": false },
    "SourceDrive": { "type": "string", "description": "Windows 11 installation media drive letter or ISO path" },
    "WorkDir": { "type": "string", "description": "Custom working directory for temporary file processing" },
    "Index": { "type": "string", "description": "Image index inside install.wim to modify" },
    "ComputerName": { "type": "string", "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,14})$", "default": "*" },
    "UserName": { "type": "string", "pattern": "^[\\p{L}\\p{N}_][\\p{L}\\p{N} ._-]{0,19}$", "default": "User" },
    "AdvancedDebloatStandard": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Selected safe standard debloat deletion components"
    },
    "AdvancedDebloatExperimental": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Selected experimental debloat deletion components (requires explicit gate)"
    },
    "IncludeMigrationAssistant": { "type": "boolean", "default": false },
    "IncludeMigrationBackup": { "type": "boolean", "default": true },
    "TweakGroups": {
      "type": "object",
      "properties": {
        "NetworkStack": { "type": "boolean" },
        "TimerBCD": { "type": "boolean" },
        "GPULatency": { "type": "boolean" },
        "ServiceTrim": { "type": "boolean" }
      }
    },
    "TweakSettings": {
      "type": "object",
      "description": "Granular individual registry and system customization toggles",
      "additionalProperties": { "type": "boolean" }
    },
    "Settings": {
      "$ref": "#",
      "description": "The settings block of a profile written by -SaveProfile (ProfileName, Version and Timestamp stay at the top level)"
    },
    "DebloatEngineSelection": {
      "type": "object",
      "description": "The engine chosen per Advanced Debloat target (written by -SaveProfile)",
      "additionalProperties": { "type": "string", "enum": ["PowerShell", "Rust"] }
    },
    "DebloatEngines": {
      "type": "object",
      "description": "Per-target execution engine for the Advanced Debloat options (PowerShell or Rust)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Engines": { "type": "array", "items": { "type": "string", "enum": ["PowerShell", "Rust"] } },
          "Default": { "type": "string", "enum": ["PowerShell", "Rust"] }
        }
      }
    },
    "BypassHardwareRequirements": { "type": "boolean", "default": true },
    "BypassNetworkRequirement": { "type": "boolean", "default": true },
    "BypassNRO": { "type": "boolean", "default": true },
    "DisableUAC": { "type": "boolean", "default": false },
    "DisableSmartScreen": { "type": "boolean", "default": false },
    "DisableVBS": { "type": "boolean", "default": false },
    "DisableWPBT": { "type": "boolean", "default": false },
    "HardenSystemSecurity": { "type": "boolean", "default": false },
    "PreventDeviceEncryption": { "type": "boolean", "default": false },
    "DisableFTH": { "type": "boolean", "default": true },
    "DisablePCA": { "type": "boolean", "default": true },
    "DisableCopilot": { "type": "boolean", "default": true },
    "DisableWebSearch": { "type": "boolean", "default": true },
    "DisableWidgets": { "type": "boolean", "default": true },
    "DisableCrossDevice": { "type": "boolean", "default": true },
    "DisableAdvertisingId": { "type": "boolean", "default": true },
    "DisableErrorReporting": { "type": "boolean", "default": true },
    "DisableIMETelemetry": { "type": "boolean", "default": true },
    "DisableCloudContent": { "type": "boolean", "default": true },
    "DisableAppPrivacy": { "type": "boolean", "default": true },
    "EnableClassicContextMenu": { "type": "boolean", "default": true },
    "EnableDarkTheme": { "type": "boolean", "default": true },
    "ShowFileExtensions": { "type": "boolean", "default": true },
    "ShowHiddenFiles": { "type": "boolean", "default": false },
    "LaunchToThisPC": { "type": "boolean", "default": true },
    "TaskbarEndTask": { "type": "boolean", "default": true },
    "TaskbarAlignLeft": { "type": "boolean", "default": true },
    "HideMeetNow": { "type": "boolean", "default": true },
    "HideSyncNotifications": { "type": "boolean", "default": true },
    "HideRecommendedSection": { "type": "boolean", "default": true },
    "DisableStartupSound": { "type": "boolean", "default": true },
    "DisableLockScreen": { "type": "boolean", "default": false },
    "DisableSleepOption": { "type": "boolean", "default": false },
    "DisableBSODEmoticon": { "type": "boolean", "default": false },
    "EnableLongPaths": { "type": "boolean", "default": true },
    "TransparentShortcutOverlay": { "type": "boolean", "default": false },
    "PhotoViewerAssociations": { "type": "boolean", "default": true },
    "TakeOwnershipContextMenu": { "type": "boolean", "default": false },
    "CmdAsAdminContextMenu": { "type": "boolean", "default": false },
    "DisableTelemetryAndDiagnostics": { "type": "boolean", "default": true },
    "DisableDefenderSecurityCenter": { "type": "boolean", "default": true },
    "OptimizeVisualEffects": { "type": "boolean", "default": true },
    "TuneMemoryAndPaging": { "type": "boolean", "default": true },
    "GamingNetworkTweaks": { "type": "boolean", "default": true },
    "LowLatencyAudioMMCSS": { "type": "boolean", "default": true },
    "DisableBackgroundApps": { "type": "boolean", "default": true },
    "DisableActivityHistory": { "type": "boolean", "default": true },
    "DisableTimeline": { "type": "boolean", "default": true },
    "DisableGameDVR": { "type": "boolean", "default": true },
    "DisableSuperfetch": { "type": "boolean", "default": true },
    "DisableWindowsSearchIndexing": { "type": "boolean", "default": true },
    "DisableFastStartup": { "type": "boolean", "default": false },
    "CleanContextMenus": { "type": "boolean", "default": true },
    "DisableCortana": { "type": "boolean", "default": true },
    "DisableDiagnosticData": { "type": "boolean", "default": true },
    "ConfigureWinlogon": { "type": "boolean", "default": false },
    "EnableScripts": { "type": "boolean", "default": true },
    "DisableWindowsAI": { "type": "boolean", "default": true },
    "DisableDeliveryOptimization": { "type": "boolean", "default": true },
    "DisablePowerThrottling": { "type": "boolean", "default": true },
    "EnableHAGS": { "type": "boolean", "default": true },
    "NtfsDisable8dot3": { "type": "boolean", "default": true },
    "ThreadDpcEnable": { "type": "boolean", "default": false },
    "NetworkTuning": { "type": "boolean", "default": false },
    "DisableIdleMaintenance": { "type": "boolean", "default": false },
    "SvcHostConsolidation": { "type": "boolean", "default": false },
    "HideSearchBox": { "type": "boolean", "default": true },
    "MenuShowDelayZero": { "type": "boolean", "default": true },
    "DisableSnapAssist": { "type": "boolean", "default": false },
    "DisableNotificationBanners": { "type": "boolean", "default": false },
    "HideExplorerHomeGallery": { "type": "boolean", "default": false },
    "HideAltTabEdgeTabs": { "type": "boolean", "default": false },
    "HideTaskViewButton": { "type": "boolean", "default": false },
    "TaskbarNeverCombine": { "type": "boolean", "default": false },
    "DisableGameMode": { "type": "boolean", "default": false },
    "ShowBatteryPercentage": { "type": "boolean", "default": false },
    "AlwaysShowScrollbars": { "type": "boolean", "default": false },
    "DisableLogonBlur": { "type": "boolean", "default": false },
    "HideOneDriveNavPane": { "type": "boolean", "default": false },
    "DisableSearchWebView2": { "type": "boolean", "default": true },
    "DisableAccessibilityHotkeys": { "type": "boolean", "default": false },
    "DisableMouseAcceleration": { "type": "boolean", "default": false },
    "DisableKeyboardDelay": { "type": "boolean", "default": false },
    "RemoveRecall": { "type": "boolean", "default": true },
    "RemoveInternetExplorer": { "type": "boolean", "default": true },
    "RemoveWordPad": { "type": "boolean", "default": true },
    "RemoveStepsRecorder": { "type": "boolean", "default": true },
    "RemoveSnippingTool": { "type": "boolean", "default": true },
    "RemovePaint": { "type": "boolean", "default": true },
    "RemoveXpsViewer": { "type": "boolean", "default": true },
    "RemovePowerShellISE": { "type": "boolean", "default": true },
    "RemoveOpenSSHClient": { "type": "boolean", "default": true },
    "RemoveHelloFace": { "type": "boolean", "default": true },
    "RemoveBitLockerFeature": { "type": "boolean", "default": true },
    "RemoveNarratorApp": { "type": "boolean", "default": true },
    "RemoveMagnifierApp": { "type": "boolean", "default": true },
    "RemoveMediaPlayerFeature": { "type": "boolean", "default": true },
    "RemoveTabletPCMath": { "type": "boolean", "default": true },
    "RemoveWebcamExperience": { "type": "boolean", "default": true },
    "RemoveWallpaperContent": { "type": "boolean", "default": true },
    "RemoveSearchEngineClient": { "type": "boolean", "default": true },
    "RemovePrintingManagement": { "type": "boolean", "default": true },
    "RemoveMpeg2Decoder": { "type": "boolean", "default": true },
    "RemoveWmic": { "type": "boolean", "default": true },
    "RemoveWirelessDisplay": { "type": "boolean", "default": true },
    "RemoveSnmpClient": { "type": "boolean", "default": true },
    "RemoveTelnetClient": { "type": "boolean", "default": true },
    "RemoveSimpleTcpClient": { "type": "boolean", "default": true },
    "RemoveRdc": { "type": "boolean", "default": true },
    "RemoveFaxClient": { "type": "boolean", "default": true },
    "RemoveUserExperienceVirt": { "type": "boolean", "default": true },
    "RemoveDeviceManagementEnt": { "type": "boolean", "default": true },
    "RemoveNotepad": { "type": "boolean", "default": true },
    "RemoveMathRecognizer": { "type": "boolean", "default": true },
    "RemovePrintingWfs": { "type": "boolean", "default": true },
    "RemoveKernelLA57": { "type": "boolean", "default": true },
    "RemoveTpmWmiProvider": { "type": "boolean", "default": true },
    "RemoveLanguageJaJP": { "type": "boolean", "default": false },
    "RemoveLanguageKoKR": { "type": "boolean", "default": true },
    "RemoveLanguageZhCN": { "type": "boolean", "default": true },
    "RemoveLanguageZhTW": { "type": "boolean", "default": true },
    "EnableCompactOS": { "type": "boolean", "default": true },
    "EnableNtfs8dot3Disable": { "type": "boolean", "default": true },
    "EnableUltimatePerformancePower": { "type": "boolean", "default": true },
    "EnableMsiMode": { "type": "boolean", "default": true },
    "DisableAccessibilityTools": { "type": "boolean", "default": false },
    "DisableWindowsSearchProcess": { "type": "boolean", "default": true },
    "DisableComputerRestore": { "type": "boolean", "default": true },
    "RemoveHelpFiles": { "type": "boolean", "default": true },
    "RemoveEdge": { "type": "boolean", "default": true },
    "RemoveWindowsBackup": { "type": "boolean", "default": true },
    "RemoveWebExperienceHost": { "type": "boolean", "default": true },
    "RemoveOfflineCacheFiles": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}
